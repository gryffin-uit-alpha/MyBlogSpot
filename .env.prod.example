# Production environment variables for AWS Lightsail deployment
# Copy this file to .env on the Lightsail instance and fill in the values

# Database credentials
DB_PASSWORD=your_secure_database_password_here

# JWT secret key (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_here

# AWS ECR Registry (format: ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com)
ECR_REGISTRY=991216470347.dkr.ecr.ap-southeast-1.amazonaws.com/blogspot
